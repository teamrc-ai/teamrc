# teamrc relay server configuration
# Copy to .env and customize for your deployment.
# docker-compose.yml requires these values — it will not start without them.

# --- Required ---

# PostgreSQL connection string
# DATABASE_URL=ecto://user:password@host/teamrc

# Enable SSL for database connections (default: true in production)
# DATABASE_SSL=true

# Cookie signing key (generate with: mix phx.gen.secret)
# SECRET_KEY_BASE=

# Session salts (any random string, different from each other)
# SESSION_SIGNING_SALT=
# LIVE_VIEW_SIGNING_SALT=
# SESSION_ENCRYPTION_SALT=

# Public hostname (used for URL generation)
# PHX_HOST=teamrc.example.com

# --- Optional: Clerk account linking ---
# Without these, teamrc works fully — team sync, CLI, invites all function.
# Clerk adds: user dashboard, machine management, account recovery.

# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_AUDIENCE=
