{
  "name": "@teamrc/cli",
  "version": "0.1.8",
  "description": "teamrc CLI - sync multi-agent teams across platforms",
  "main": "dist/index.js",
  "bin": {
    "teamrc": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/teamrc-ai/teamrc.git",
    "directory": "cli"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "claude",
    "cursor",
    "codex",
    "gemini",
    "team",
    "sync"
  ],
  "scripts": {
    "build": "tsc && cp -r ../templates dist/templates",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && chmod +x dist/index.js && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@noble/ed25519": "^2.2.0",
    "@noble/hashes": "^1.7.0",
    "chokidar": "^5.0.0",
    "commander": "^13.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
